rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model:
    // users/{uid}/notes/{noteId}
    // examLabel: string, 1-60 chars; examDate: empty or YYYY-MM-DD string;
    // subject/kind: allowlisted strings; title: string, 1-80 chars;
    // body: string, 1-1400 chars; reviewDate: empty or YYYY-MM-DD string;
    // createdAt and updatedAt: timestamps. createdAt is immutable.
    // User profile documents and all other collections are not used or accessible.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Notes are scoped by UID in their path and must not carry a second owner field.
    function uidUnchanged(data, userId) {
      return !('uid' in data) || data.uid == userId;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function isValidNote(data) {
      return data.keys().hasAll([
          'examLabel', 'examDate', 'subject', 'kind', 'title', 'body',
          'reviewDate', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'examLabel', 'examDate', 'subject', 'kind', 'title', 'body',
          'reviewDate', 'createdAt', 'updatedAt'
        ]) &&
        data.examLabel is string && data.examLabel.size() >= 1 && data.examLabel.size() <= 60 &&
        data.examDate is string && data.examDate.size() <= 10 &&
        (data.examDate == '' || data.examDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) &&
        data.subject in ['국어', '수학', '영어', '한국사', '탐구', '기타'] &&
        data.kind in ['오답', '핵심 개념', '질문', '학습 메모'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 1400 &&
        data.reviewDate is string && data.reviewDate.size() <= 10 &&
        (data.reviewDate == '' || data.reviewDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp;
    }

    match /users/{userId}/notes/{noteId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && uidUnchanged(request.resource.data, userId) &&
        isValidNote(request.resource.data) &&
        request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId) && uidNotModified() &&
        isValidNote(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
